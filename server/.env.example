# Server environment variables example
# Copy this file to .env and replace the placeholders with real values

# MongoDB connection
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/dbname

# JWT secret (required)
JWT_SECRET=replace_with_a_strong_random_secret

# Cloudinary (optional, for image uploads)
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# Frontend and CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Gemini AI (optional)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Server port (optional)
PORT=3000

# SMTP settings (optional - required to send OTP emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp_user
SMTP_PASS=smtp_password
FROM_EMAIL=no-reply@example.com
